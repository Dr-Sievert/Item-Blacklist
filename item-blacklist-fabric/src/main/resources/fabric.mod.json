{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "contact": {
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.sievert.item_blacklist.fabric.ItemBlacklistFabric"],
    "client": ["net.sievert.item_blacklist.fabric.client.ItemBlacklistFabricClient"],
    "jei_mod_plugin": ["net.sievert.item_blacklist.integration.jei.line.JeiPluginEntry::PLUGIN"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "jeresources": "*"
  }
}
